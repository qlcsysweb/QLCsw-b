{
  "name": "qlc-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm run prisma:generate",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "prisma:generate": "prisma generate --schema prisma/education/schema.prisma && prisma generate --schema prisma/trading/schema.prisma",
    "prisma:status:education": "prisma migrate status --schema prisma/education/schema.prisma",
    "prisma:status:trading": "prisma migrate status --schema prisma/trading/schema.prisma",
    "prisma:deploy:education": "prisma migrate deploy --schema prisma/education/schema.prisma",
    "prisma:deploy:trading": "prisma migrate deploy --schema prisma/trading/schema.prisma",
    "seed:education": "node --env-file-if-exists=.env prisma/education/seed.js",
    "seed:trading": "node prisma/trading/seed.cjs",
    "render:build": "npm ci && PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 npm run prisma:deploy:education && node prisma/education/seed.js",
    "sync:shared:education": "node scripts/education/syncShared.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^178.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.3.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "streamifier": "^0.1.1",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
