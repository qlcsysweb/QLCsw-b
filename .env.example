DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_NAME=qlc_session
ENCRYPTION_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GMAIL_USER=
GMAIL_APP_PASSWORD=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Bootstrap del primer ADMIN (prisma/seed.js) — NO son credenciales
# permanentes. PASSWORD solo se usa una vez para crear la cuenta si no
# existe todavía; el seed la borra de .env automáticamente después.
# Nunca coloques aquí una contraseña real — este archivo es de ejemplo.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
