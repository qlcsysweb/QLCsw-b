# Copia este archivo a .env y completa los valores reales — nunca commitees el .env real.

# Base de datos (NeonDB / PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

PORT=4000
NODE_ENV=development

# URL del frontend a la que el backend redirige tras completar el OAuth2 de
# Google (Drive/Gmail) — es una sola URL "canónica", no una lista. Usa el
# dominio propio del frontend.
CLIENT_ORIGIN=https://www.qlctrade.net

# URL pública del backend (Render), sin barra final — se usa para construir
# el redirect_uri del flujo OAuth2 de Google (Drive/Gmail).
BACKEND_PUBLIC_URL=https://qlcsw-b.onrender.com

# CORS — lista de orígenes de frontend permitidos, separados por comas, SIN
# barra final. Los orígenes de qlctrade.net y de la URL de Vercel ya están
# permitidos por defecto en el código (ver src/config/corsConfig.js) aunque
# esta variable no se configure; úsala para agregar otros (p. ej. una nueva
# URL de preview de Vercel) sin tener que tocar código.
ALLOWED_ORIGINS=https://www.qlctrade.net,https://qlctrade.net,https://ql-csw-f-git-main-qlc1.vercel.app,https://ql-csw-f.vercel.app

# Autenticación
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
COOKIE_NAME=qlc_session

# Cifrado de credenciales sensibles guardadas en DB (OAuth2 refresh tokens, etc.)
ENCRYPTION_KEY=cambia-esto-por-una-clave-de-32-bytes

# Cloudinary (imágenes públicas del sitio, no documentos de clientes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TWO_FA_ENABLED=false

# Gmail (envío de correos transaccionales) — mismo patrón OAuth2 que Drive,
# ver Admin → Configuración → Correo; estas dos son solo el fallback legado.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Solo usados por prisma/seed.js para crear el primer admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
